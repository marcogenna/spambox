[Unit]
Description=SpamBox - interfaccia web di amministrazione
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=spambox
Group=spambox
WorkingDirectory=/opt/spambox
Environment="SPAMBOX_CONFIG=/opt/spambox/config/config.yaml"
EnvironmentFile=-/opt/spambox/config/spambox.env
ExecStart=/opt/spambox/venv/bin/uvicorn spambox.webapp.app:app --host 127.0.0.1 --port 8088
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/spambox/data /opt/spambox/logs
ProtectHome=true

[Install]
WantedBy=multi-user.target
