# Esempio di file di variabili d'ambiente per systemd (EnvironmentFile).
# Copiare come config/spambox.env, valorizzare e impostare permessi 600.
# Queste variabili hanno sempre precedenza sui valori in config.yaml.

SPAMBOX_IMAP_PASSWORD=CAMBIAMI
SPAMBOX_SMTP_PASSWORD=CAMBIAMI
SPAMBOX_VT_API_KEY=CAMBIAMI
SPAMBOX_RSPAMD_PASSWORD=
SPAMBOX_WEB_USERNAME=admin
SPAMBOX_WEB_PASSWORD_SHA256=CAMBIAMI_CON_OUTPUT_DI_scripts_hash_password.py
SPAMBOX_WEB_SESSION_SECRET=CAMBIAMI_STRINGA_CASUALE_LUNGA
