# Configurazione per scripts/backup.sh.
# Copiare come config/backup.env e valorizzare. Non committare con dati reali
# se il repository non è privato.

# Remote rclone (già configurato con "rclone config") e path di destinazione.
# Esempi: "gdrive:spambox-backups", "s3-backblaze:mio-bucket/spambox", "nas:backup/spambox"
RCLONE_REMOTE="gdrive:spambox-backups"

# Percorso del file di configurazione rclone, se diverso dal default
# ($HOME/.config/rclone/rclone.conf dell'utente che esegue il backup).
# RCLONE_CONFIG="/opt/spambox/.rclone.conf"

# Giorni di retention sui backup remoti: quelli più vecchi vengono eliminati
# automaticamente dopo ogni backup riuscito. Impostare a 0 per disabilitare.
BACKUP_RETENTION_DAYS=30
